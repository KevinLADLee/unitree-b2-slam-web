# ============================================
# Unitree B2 SLAM Backend Configuration
# ============================================

# 运行模式
# true: 仿真模式（不需要真实硬件和 SDK）
# false: 真实模式（需要连接 Unitree B2 机器人）
SIMULATOR_MODE=true

# 网络配置（仅真实模式需要）
# 网络接口名称，例如 'eth0', 'enp0s3' 等
# 留空则使用默认接口
NETWORK_INTERFACE=

# 数据存储路径
MAP_STORAGE_PATH=./data/map_registry.json

# 日志配置
LOG_LEVEL=INFO
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/backend.log

# 服务端口配置
HOST=0.0.0.0
PORT=8000

# CORS 配置（前端域名）
# 多个域名用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# WebSocket 配置
WS_HEARTBEAT_INTERVAL=30
# WebSocket 心跳间隔（秒）

# 命令超时配置
COMMAND_TIMEOUT=5
# 命令执行超时时间（秒）

# Odometry 推送频率
ODOMETRY_PUBLISH_RATE=10
# 里程计推送频率（Hz）
